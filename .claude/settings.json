{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/*service-account*.json)",
      "Read(**/*credentials*.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(//proc/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.cache/huggingface/**)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(env -0)",
      "Bash(export)",
      "Bash(export -p)",
      "Bash(declare -p)",
      "Bash(declare -p *)",
      "Bash(declare -x)",
      "Bash(set)",
      "Bash(set -x)",
      "Bash(gh pr merge *)",
      "Bash(gh api */merge)",
      "Bash(gh api */merge *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_secrets.py", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session_start.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
