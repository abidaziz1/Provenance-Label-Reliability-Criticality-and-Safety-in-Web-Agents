# Copy to .env for local runs only. This file is gitignored; never commit a real value.
# In a managed remote environment, set these in the environment settings instead.
# Names only. Never put a real value in this file.

# Research key for Anthropic models used in experiments. Keep it separate from the
# provider's default SDK variable so development tooling cannot use research budget.
RESEARCH_ANTHROPIC_API_KEY=
# Use the literal value proxy-injected when the cloud environment attaches the key as an API credential.
OPENAI_API_KEY=
# Optional. Google's API may be blocked in some sandboxes; Colab always works.
GEMINI_API_KEY=
# Optional. The dataset is public; a read token only avoids rate limits.
HF_TOKEN=
# Optional. Only if you want Slack pings for needs-human tasks.
SLACK_WEBHOOK_URL=
