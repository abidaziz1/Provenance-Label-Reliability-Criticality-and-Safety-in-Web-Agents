# Copy to .env for LOCAL runs only (.env is gitignored; Claude Code is denied read access to .env and .env.*).
# In a Claude Code cloud environment, set these in the environment settings instead, never in the repo.
# Names only. Never put a real value in this file.

# Research key for Claude models used AS EXPERIMENT SUBJECTS. Not ANTHROPIC_API_KEY on purpose:
# Claude Code would otherwise use it for its own requests.
RESEARCH_ANTHROPIC_API_KEY=
# Use the literal value proxy-injected when the cloud environment attaches the key as an API credential.
OPENAI_API_KEY=
# Optional. Google's API may be blocked in some sandboxes; Colab always works.
GEMINI_API_KEY=
# Optional. The dataset is public; a read token only avoids rate limits.
HF_TOKEN=
# Optional. Only if you want Slack pings for needs-human tasks.
SLACK_WEBHOOK_URL=
